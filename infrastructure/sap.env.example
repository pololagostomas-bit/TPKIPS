# No subir este archivo con valores reales.
SAP_BASE_URL=https://servidor-sap:50000
SAP_COMPANY_DB=EMPRESA_PRUEBA
SAP_USERNAME=usuario_solo_lectura
SAP_PASSWORD=guardar_en_key_vault

# Debe ser una consulta OData aprobada por TI/SAP que exponga una fila por línea
# de OV e incluya al menos: número de OV, línea, SKU, descripción, cantidad
# pendiente, stock disponible, tipo de atención, destino y estado de máquina.
SAP_OPEN_ORDERS_QUERY=Orders?$select=DocEntry,DocNum,CardCode,CardName
