# Configuración de App Service / Container Apps
HOST=0.0.0.0
PORT=8000
TRITON_AUTH_MODE=entra
# Piloto de una sola instancia: almacenamiento persistente propio de App Service.
# No montar Azure Files para SQLite: no es compatible con sus bloqueos de archivo.
TRITON_DB_PATH=/home/data/triton.db
# App Service debe dirigir tráfico al puerto del contenedor.
WEBSITES_PORT=8000
