# Configuración de App Service / Container Apps
HOST=0.0.0.0
PORT=8000
TRITON_AUTH_MODE=entra
# Piloto de una sola instancia: almacenamiento persistente propio de App Service.
# No montar Azure Files para SQLite: no es compatible con sus bloqueos de archivo.
TRITON_DB_PATH=/home/data/triton.db
# App Service debe dirigir tráfico al puerto del contenedor.
WEBSITES_PORT=8000

# Microsoft Graph / SharePoint. La URL debe ser el enlace de compartir de cada Excel.
# Si no se define GRAPH_CLIENT_SECRET, el piloto usa inicio de sesión delegado
# en el navegador y guarda el caché local en GRAPH_TOKEN_CACHE_PATH.
GRAPH_TENANT_ID=108ab96b-5b54-4c6f-a691-cd77954e1af1
GRAPH_CLIENT_ID=2637d6cb-1bc8-4798-834e-98621684d83b
# GRAPH_CLIENT_SECRET=
GRAPH_TOKEN_CACHE_PATH=data/msal_token_cache.bin
GRAPH_SHARE_URL_DISPATCH=
GRAPH_SHARE_URL_STOCK=
GRAPH_SHARE_URL_IMPORTATION=
GRAPH_SHARE_URL_ACCOUNTING=
