# Copiar como .env. No versionar .env ni contraseñas reales.
HOST=0.0.0.0
PORT=8000
TRITON_BIND_ADDRESS=0.0.0.0
TRITON_HOST_PORT=8080

# Producción usa autenticación local. La aplicación debe rechazar el arranque
# si falta cualquiera de las credenciales bootstrap.
TRITON_AUTH_MODE=local
TRITON_BOOTSTRAP_ADMIN_USERNAME=admin
TRITON_BOOTSTRAP_ADMIN_PASSWORD=

TRITON_DB_PATH=/home/data/triton.db
TRITON_ADVANCED_LOTS=0
TRITON_SESSION_HOURS=12
# Responsables predeterminados de nuevas BL/importaciones. Si quedan vacíos,
# se usa el primer usuario activo de cada rol; el administrador puede cambiarlo.
TRITON_DEFAULT_RECEPTION_ASSISTANT=
TRITON_DEFAULT_RECEPTION_AUXILIARY=
# 1 cuando se publique mediante HTTPS. En la red LAN HTTP, 0.
TRITON_COOKIE_SECURE=0
# Configure el nombre del volumen EXISTENTE antes de actualizar el servidor.
TRITON_DATA_VOLUME=

# Correo: permanece deshabilitado hasta que TI configure Microsoft Graph.
TRITON_MAIL_ENABLED=0
TRITON_MAIL_FROM=tomas.polo@triton.com.pe
TRITON_GRAPH_TENANT_ID=
TRITON_GRAPH_CLIENT_ID=
TRITON_GRAPH_CLIENT_SECRET=
TRITON_IMPORTACIONES_EMAILS=sgallo@triton.com.pe,claudia.acedo@triton.com.pe,jorge.cucho@triton.com.pe,pfigueroa@triton.com.pe
TRITON_CONTABILIDAD_EMAILS=mpucurimay@triton.com.pe

# Copias online. En producción, además copie /home/backups fuera del host.
TRITON_BACKUP_DIR=/home/backups
TRITON_BACKUP_INTERVAL_SECONDS=86400
TRITON_BACKUP_RETENTION_COUNT=30
TRITON_BACKUP_RETENTION_DAYS=30
